{
  "name": "@apps/auth-ms",
  "version": "1.0.0",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build -p ./tsconfig.build.json",
    "start": "node dist/main.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "mig:gen": "pnpm run typeorm migration:generate -d src/database/data-source.ts",
    "mig:rev": "pnpm run typeorm migration:revert -d src/database/data-source.ts",
    "mig:run:dev": "ts-node --project tsconfig.json src/database/scripts/migrate.script.ts",
    "mig:run:prod": "node dist/database/scripts/migrate.script.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@packages/types": "workspace:*",
    "@packages/users": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@packages/tsconfig": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.20"
  }
}
