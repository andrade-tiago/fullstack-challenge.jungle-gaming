{
  "name": "@apps/tasks-ms",
  "version": "1.0.0",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "ts-node-dev": "ts-node-dev --project ./tsconfig.json -r tsconfig-paths/register",
    "ts-node": "ts-node --project ./tsconfig.json -r tsconfig-paths/register",
    "dev": "pnpm ts-node-dev src/main.ts",
    "build": "nest build -p ./tsconfig.build.json",
    "start": "node dist/main.js",
    "typeorm": "pnpm ts-node ./node_modules/typeorm/cli.js",
    "mig:gen": "pnpm typeorm migration:generate -d src/database/data-source.ts",
    "mig:rev": "pnpm typeorm migration:revert -d src/database/data-source.ts",
    "mig:run:dev": "pnpm ts-node src/database/scripts/migrate.script.ts",
    "mig:run:prod": "node dist/database/scripts/migrate.scripts.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@packages/microservices": "workspace:*",
    "@packages/tasks": "workspace:*",
    "@packages/types": "workspace:*",
    "@packages/users": "workspace:*",
    "@packages/utils": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@packages/tsconfig": "workspace:*",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
